{
  "name": "lightning-todo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "極速待辦事項 — Rust + Axum API，React + Vite 前端，三層測試（單元 / API / E2E）",
  "scripts": {
    "server": "cargo run --manifest-path server/Cargo.toml",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "test:unit": "cargo test --manifest-path server/Cargo.toml --lib",
    "test:api": "cargo test --manifest-path server/Cargo.toml --test api",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
